<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="734" Height="876" TextElement.FontFamily="Microsoft YaHei UI" TextElement.Foreground="#183044" TextElement.FontSize="14">
 <Grid.Resources>
  <Style TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#183044"/><Setter Property="BorderBrush" Value="#DEE7EC"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.68"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.44"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#168D98"/><Setter TargetName="Shell" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Background" Value="#FAFCFD"/><Setter Property="BorderBrush" Value="#DFE8ED"/><Setter Property="Foreground" Value="#4F6C81"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="Toggle" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#FAFCFD" BorderBrush="#DFE8ED" BorderThickness="1" CornerRadius="4"/></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="8,2" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/><Path Data="m6 9 6 6 6-6" Stroke="#587186" StrokeThickness="1.5" Width="9" Height="5" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False"/><Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="White" BorderBrush="#DFE8ED" BorderThickness="1" CornerRadius="5" MinWidth="120" Padding="4"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Grid.Resources>
 <Border Background="#FBFCFD" BorderBrush="#DEE6EB" BorderThickness="1" CornerRadius="12">
  <Grid ClipToBounds="True">
   <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border x:Name="TitleBar" Background="#1D394E" CornerRadius="11,11,0,0">
    <Grid Margin="16,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
     <Image x:Name="TitleIcon" Width="20" Height="20"/><TextBlock Grid.Column="1" Text="应急·轻" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" FontSize="14" Margin="6,0,0,0"/>
     <Button x:Name="MinimizeButton" Grid.Column="2" Background="Transparent" BorderThickness="0" Foreground="White" Padding="0" Margin="0,6"/>
     <Button x:Name="CloseButton" Grid.Column="3" Background="Transparent" BorderThickness="0" Foreground="White" Padding="0" Margin="0,6"/>
    </Grid>
   </Border>
   <Grid Grid.Row="1" Margin="32,26,32,24">
    <Grid.RowDefinitions><RowDefinition Height="122"/><RowDefinition Height="122"/><RowDefinition Height="96"/><RowDefinition Height="190"/><RowDefinition Height="26"/><RowDefinition Height="60"/><RowDefinition x:Name="LogRow" Height="0"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
     <Image x:Name="BrandLogo" Width="58" Height="58" VerticalAlignment="Top" Stretch="Uniform"/>
     <StackPanel Grid.Column="1" Margin="16,3,0,0"><TextBlock Text="问渠安全实验室" FontSize="18" FontWeight="Bold"/><TextBlock Text="应急·轻 / WINDOWS" FontSize="10" Foreground="#718696" Margin="1,5,0,0"/></StackPanel>
     <TextBlock Grid.Column="2" Text="专注实战 · 简单可靠" FontSize="12" Foreground="#667D8F" HorizontalAlignment="Right" Margin="0,9,0,0"/>
    </Grid>
    <StackPanel Grid.Row="1"><TextBlock Text="一键检查，定位异常" FontSize="38" FontWeight="Bold" Margin="0,0,0,14"/><TextBlock Text="快速排查主机异常行为，辅助应急处置" FontSize="18" Foreground="#587186"/></StackPanel>
    <Grid Grid.Row="2" VerticalAlignment="Top"><Grid.ColumnDefinitions><ColumnDefinition Width="246"/><ColumnDefinition Width="14"/><ColumnDefinition Width="196"/><ColumnDefinition Width="14"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
     <Button x:Name="ScanButton" Height="70" Background="#078F99" Foreground="White" BorderBrush="#078F99" FontWeight="SemiBold" FontSize="19"/>
     <Button x:Name="ReportButton" Grid.Column="2" Height="70" FontWeight="SemiBold" FontSize="17" IsEnabled="False"/>
     <Button x:Name="FolderButton" Grid.Column="4" Height="70" FontWeight="SemiBold" FontSize="17" IsEnabled="False"/>
    </Grid>
    <Border Grid.Row="3" Background="White" BorderBrush="#E3EAEF" BorderThickness="1" CornerRadius="10" Padding="20,20,18,17">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="282"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Border Background="#F3F6F8" CornerRadius="8" Width="62" Height="64" VerticalAlignment="Center"><ContentControl x:Name="StateIcon"/></Border>
       <StackPanel Grid.Column="1" Margin="16,13,0,0"><TextBlock Text="当前状态" FontSize="13" Foreground="#6A8092"/><TextBlock x:Name="StatusText" Text="已就绪" FontSize="24" FontWeight="Bold" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
       <TextBlock x:Name="StatusHint" Grid.Row="1" Grid.ColumnSpan="2" Text="可对本机进行快速检查，收集关键痕迹" FontSize="12" Foreground="#70889B" TextWrapping="Wrap" Margin="0,10,12,0"/>
      </Grid>
      <Border Grid.Column="1" Background="#E5EBEF"/>
      <Grid Grid.Column="2" Margin="23,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="33"/><RowDefinition Height="33"/><RowDefinition Height="33"/><RowDefinition Height="33"/></Grid.RowDefinitions>
       <ContentControl x:Name="OsIcon" VerticalAlignment="Top"/><TextBlock Grid.Column="1" Text="操作系统" FontSize="11"/><TextBlock x:Name="OsText" Grid.Column="2" FontSize="11" TextTrimming="CharacterEllipsis"/>
       <ContentControl x:Name="HostIcon" Grid.Row="1" VerticalAlignment="Top"/><TextBlock Grid.Row="1" Grid.Column="1" Text="主机名称" FontSize="11"/><TextBlock x:Name="HostText" Grid.Row="1" Grid.Column="2" FontSize="11" TextTrimming="CharacterEllipsis"/>
       <ContentControl x:Name="ScopeIcon" Grid.Row="2" VerticalAlignment="Top"/><TextBlock Grid.Row="2" Grid.Column="1" Text="回溯范围" FontSize="11"/><ComboBox x:Name="WindowSelect" Grid.Row="2" Grid.Column="2" FontSize="11" Height="24" VerticalAlignment="Top" SelectedIndex="1" BorderBrush="#E2E9EE"><ComboBoxItem Content="24 小时"/><ComboBoxItem Content="72 小时"/><ComboBoxItem Content="7 天"/></ComboBox>
       <ContentControl x:Name="OutputIcon" Grid.Row="3" VerticalAlignment="Top"/><TextBlock Grid.Row="3" Grid.Column="1" Text="输出目录" FontSize="11"/><TextBlock x:Name="OutputText" Grid.Row="3" Grid.Column="2" Text="桌面 / 应急轻报告" FontSize="11" TextTrimming="CharacterEllipsis"/>
      </Grid>
     </Grid>
    </Border>
    <ProgressBar x:Name="ScanProgress" Grid.Row="3" Height="3" VerticalAlignment="Bottom" Margin="12,0,12,0" Foreground="#078F99" Background="Transparent" BorderThickness="0" Visibility="Collapsed"/>
    <Button x:Name="LogToggle" Grid.Row="5" Padding="18,0" HorizontalContentAlignment="Stretch" FontSize="13">
     <Grid Width="630"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="195"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><ContentControl x:Name="LogIcon"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="采集日志" FontWeight="SemiBold"/><TextBlock x:Name="LogState" Text="（已折叠）" Foreground="#7A8FA0" Margin="8,0,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="点击展开查看运行日志" FontSize="12" Foreground="#7A8FA0" HorizontalAlignment="Right" Margin="0,0,12,0"/><ContentControl x:Name="LogChevron" Grid.Column="3"/></Grid>
    </Button>
    <Border x:Name="LogPanel" Grid.Row="6" Background="White" BorderBrush="#E3EAEF" BorderThickness="1" CornerRadius="8" Margin="0,10,0,0" Visibility="Collapsed"><TextBox x:Name="LogText" BorderThickness="0" Margin="10" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="11" Background="Transparent" Foreground="#667D8F"/></Border>
    <Grid Grid.Row="7" VerticalAlignment="Bottom"><TextBlock Text="问渠安全实验室  |  安全来自持续的好奇心" FontSize="11" Foreground="#8598A6"/><TextBlock Text="v1.13" FontSize="11" Foreground="#8598A6" HorizontalAlignment="Right"/></Grid>
   </Grid>
  </Grid>
 </Border>
</Grid>
